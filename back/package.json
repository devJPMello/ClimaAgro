{
  "name": "climaagro-backend",
  "version": "1.0.0",
  "description": "Backend API para o sistema ClimaAgro",
  "main": "src/server.js",
  "scripts": {
    "db:init": "node src/scripts/dbInit.js",
    "start": "node src/server.js",
    "dev": "npm run db:init && nodemon src/server.js",
    "start:dev": "npm run db:init && nodemon src/server.js",
    "test": "jest",
    "seed:geo": "node src/scripts/seedGeoData.js",
    "seed:productivity": "node src/scripts/seedProductivityData.js",
    "seed:agronomos": "node src/scripts/seedAgronomosParceiros.js",
    "seed:all": "npm run seed:geo && npm run seed:productivity",
    "db:reset": "npm run seed:all",
    "sync:climate": "node src/scripts/syncRealClimateData.js",
    "purge:seed": "node src/scripts/purgeInventedSeedData.js",
    "import:ibge1612": "node src/scripts/importIbgeSidra1612Csv.js",
    "sync:productivity-ibge": "node src/scripts/syncProductivityFromIbgeSidra1612.js",
    "migrate:climate-uf": "node src/scripts/migrateClimateUfColumn.js",
    "reset:state-level-data": "node src/scripts/resetStateLevelData.js",
    "migrate:productivity-label": "node src/scripts/migrateProductivityProductLabel.js",
    "migrate:productivity-municipality": "node src/scripts/migrateProductivityMunicipalityColumns.js",
    "migrate:productivity-crop-type-varchar": "node src/scripts/migrateCropTypeEnumToVarchar.js",
    "geo:ensure-tocantins-municipios": "node src/scripts/ensureTocantinsMunicipiosGeoData.js",
    "geo:geocode-tocantins": "node src/scripts/geocodeTocantinsMunicipiosGeoData.js",
    "geo:ensure-brazil-states": "node src/scripts/ensureBrazilStatesGeoData.js"
  },
  "keywords": ["clima", "agricultura", "api", "nodejs"],
  "author": "ClimaAgro Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.35.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.5.0",
    "iconv-lite": "^0.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.2",
    "turf": "^3.0.14"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
