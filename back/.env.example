# Copie para .env e preencha. Nunca commite o .env com valores reais.

# Servidor
PORT=5000
NODE_ENV=development
# Atrás de proxy (Render, etc.): número de proxies confiáveis
TRUST_PROXY=

# Banco PostgreSQL (ex.: Neon) com extensão PostGIS
DATABASE_URL=postgresql://usuario:senha@host:5432/climaagro

# Clerk (autenticação)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_USER_IDS=

# CORS: URL do frontend
FRONTEND_URL=http://localhost:5173
# URL pública HTTPS da API (webhook do WhatsApp)
PUBLIC_API_BASE_URL=

# Sincronização climática (POST /api/climate/sync, header X-ClimaAgro-Sync-Token)
# Gere um valor aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIMATE_SYNC_SECRET=
ENABLE_CLIMATE_AUTO_SYNC=true
CLIMATE_AUTO_SYNC_EVERY_HOURS=12
CLIMATE_AUTO_SYNC_RUN_ON_BOOT=true
CLIMATE_SYNC_SCOPE=brasil

# CPTEC / INPE (XML)
ENABLE_CPTEC_SYNC=true
ENABLE_CPTEC_METAR=true
CPTEC_BASE_URL=http://servicos.cptec.inpe.br/XML

# Open-Meteo (clima numérico diário)
ENABLE_OPEN_METEO_SYNC=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEZONE=America/Sao_Paulo
OPEN_METEO_PAST_DAYS=7
OPEN_METEO_FORECAST_DAYS=7

# INMET (alertas oficiais)
ENABLE_INMET_SYNC=true
ENABLE_INMET_ALERTS_SYNC=true
INMET_ADAPTER_BASE_URL=
INMET_ADAPTER_ALERT_RSS_URL=

# Alertas ao vivo (JSON HTTPS, separados por vírgula)
ALERTS_FETCH_LIVE_ON_READ=false
OFFICIAL_ALERT_JSON_URLS=

# Google Gemini (IAgro e relatórios com IA)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=

# Evolution API / WhatsApp (opcional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
